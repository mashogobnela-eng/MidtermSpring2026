<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Persistence unit for storing UNO game history.

        Defaults to a file-based H2 database at ./data/uno so history survives
        between runs; AUTO_SERVER lets the game and a separate report command
        open it at the same time. Tests override the JDBC url with an in-memory
        H2 database and create-drop schema (see TestDatabase), so they never
        touch this file or any developer-specific state.

        No credentials are stored here beyond H2's empty default password, and
        nothing machine-specific is hard-coded.
    -->
    <persistence-unit name="uno-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>uno.persistence.PlayerEntity</class>
        <class>uno.persistence.GameEntity</class>
        <class>uno.persistence.RoundEntity</class>
        <class>uno.persistence.ScoreEntity</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:file:./data/uno;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
